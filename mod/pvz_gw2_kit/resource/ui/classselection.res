// pvz_gw2_kit class-selection override
// Replaces the tooltip blurb for each class with its PvZ-flavored equivalent.
// Class pick buttons still use TF2 class portraits (models unchanged, per Melty rule).

"Resource/UI/ClassSelection.res"
{
    "ScoutInfo"
    {
        "ControlName"       "CTFClassInfoPanel"
        "fieldName"         "ScoutInfo"
        "visible"           "1"
        "tooltip_title"     "#TF_ClassSelect_Scout_Title"
        "tooltip_desc"      "#TF_ClassSelect_Scout_Desc_BLU"
    }
    "PyroInfo"
    {
        "ControlName"       "CTFClassInfoPanel"
        "fieldName"         "PyroInfo"
        "tooltip_title"     "#TF_ClassSelect_Pyro_Title"
        "tooltip_desc"      "#TF_ClassSelect_Pyro_Desc"
    }
