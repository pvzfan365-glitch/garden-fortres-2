  "team_gating": {
    "mechanism": "TF2 cannot natively branch sound by team for a shared class. For slots that collide (scout BLU vs scout RED), we author two sound script entries with distinct wave paths and switch the active VPK via a tf_bot_force_class listener in cfg/mods/pvz_gw2_kit.cfg. See hooks.json#vo_team_gating.",
    "collisions": ["scout (BLU=Peashooter, RED=Imp)"]
  },
