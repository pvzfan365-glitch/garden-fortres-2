    {
        "ControlName"       "CTFClassInfoPanel"
        "fieldName"         "MedicInfo"
        "tooltip_title"     "#TF_ClassSelect_Medic_Title"
        "tooltip_desc"      "#TF_ClassSelect_Medic_Desc"
    }
    "SniperInfo"
    {
        "ControlName"       "CTFClassInfoPanel"
        "fieldName"         "SniperInfo"
        "tooltip_title"     "#TF_ClassSelect_Sniper_Title"
